# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Format: postgresql://username:password@host:port/database
# Docker setup: postgresql://gastrouser:gastropass123@localhost:5432/gastroapp_db
# Local setup: postgresql://postgres:yourpassword@localhost:5432/gastroapp_db
DATABASE_URL="postgresql://gastrouser:gastropass123@localhost:5432/gastroapp_db"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens (MUST be changed in production!)
# Use a strong random string: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Token expiration time (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN="7d"

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
# Format: redis://host:port or redis://:password@host:port
# Docker setup: redis://localhost:6379
# Local setup: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server port
PORT=3001

# Environment: development, staging, production
NODE_ENV="development"

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Frontend URL (for CORS headers)
# Development: http://localhost:5173
# Production: https://gastroapp.com
CLIENT_URL="http://localhost:5173"

# ============================================================================
# OPTIONAL: SOCKET.IO CONFIGURATION
# ============================================================================
# SOCKET_IO_PATH="/socket.io"
# SOCKET_IO_TRANSPORT="websocket,polling"

# ============================================================================
# OPTIONAL: LOGGING CONFIGURATION
# ============================================================================
# LOG_LEVEL="debug"
# LOG_FORMAT="json"
