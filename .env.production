# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL POSTGRES
# ============================================================================

# DATABASE - Vercel Postgres (auto-generated)
# Use POSTGRES_PRISMA_URL for Prisma (includes connection pool)
DATABASE_URL="${POSTGRES_PRISMA_URL}"

# JWT AUTHENTICATION
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# SERVER CONFIGURATION
PORT="3001"
NODE_ENV="production"

# CORS - Frontend URL
CLIENT_URL="https://algodecomida-ancr.vercel.app"

# ============================================================================
# HOW TO SET UP IN VERCEL
# ============================================================================
# 1. Go to vercel.com/dashboard
# 2. Select your backend project
# 3. Go to Storage > Create Database > Postgres
# 4. Wait for auto-generated DATABASE_URL
# 5. Go to Settings > Environment Variables
# 6. Add JWT_SECRET and other variables manually
# 7. The DATABASE_URL will be auto-added from Postgres
# ============================================================================
