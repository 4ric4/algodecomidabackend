# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL
# ============================================================================
# Copy and paste all these variables in Vercel Dashboard:
# Settings > Environment Variables > Add new
# ============================================================================

# DATABASE - Use Vercel Postgres (recommended)
# If using Vercel Postgres, this will be auto-generated
# If using external database, replace with your URL
DATABASE_URL="postgresql://user:password@host:port/dbname"

# JWT AUTHENTICATION
# Change this to a strong random secret!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# REDIS CACHE (optional for now)
# Leave empty if not using Redis
REDIS_URL="redis://localhost:6379"

# SERVER CONFIGURATION
PORT="3001"
NODE_ENV="production"

# CORS - Frontend URL
CLIENT_URL="https://algodecomida-ancr.vercel.app"

# ============================================================================
# INSTRUCTIONS FOR VERCEL
# ============================================================================
# 1. Go to vercel.com/dashboard
# 2. Select your backend project
# 3. Go to Settings > Environment Variables
# 4. Add each variable above (NAME = VALUE)
# 5. Save and redeploy
#
# DATABASE_URL will be auto-generated if you use Vercel Postgres:
# - In dashboard, go to Storage > Connect > Postgres > Create New
# - It will auto-add DATABASE_URL
#
# For JWT_SECRET, generate a strong one:
# openssl rand -base64 32
# ============================================================================
