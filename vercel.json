{
  "buildCommand": "npm run build && npm run prisma:generate",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "express",
  "outputDirectory": "dist",
  "functions": {
    "src/index.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api/health",
      "permanent": false
    }
  ]
}
